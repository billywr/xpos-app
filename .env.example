# XPOS API (no trailing slash). Dev: 9003, Prod: use 9005 when building Docker image
VITE_API_BASE_URL=http://localhost:9003

# Keycloak token endpoint (password grant for login)
# No trailing slash. Example: http://localhost:8088 (token path: /realms/xpos/protocol/openid-connect/token)
VITE_KEYCLOAK_URL=http://localhost:8088
VITE_KEYCLOAK_REALM=xpos
VITE_KEYCLOAK_CLIENT_ID=xpos-client-api

# Optional
# VITE_APP_NAME=XPOS

# Idle auto-logout: minutes of inactivity before redirect to login (omit for default 5)
# VITE_IDLE_LOGOUT_MINUTES=15
