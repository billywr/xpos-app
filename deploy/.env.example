# XPOS Deployment - copy to .env and adjust
# Prerequisites: Postgres, Kafka, Keycloak already running on host
# cp .env.example .env

# ===== Image names (required) =====
XPOS_IMAGE=ghcr.io/your-org/xpos:latest
XPOS_UI_IMAGE=ghcr.io/your-org/xpos-ui:latest

# ===== Ports (host mapping for xpos and xpos-ui) =====
XPOS_PORT=9003
XPOS_UI_PORT=9011

# ===== External PostgreSQL (on host) =====
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xpos

# ===== External Kafka (on host) =====
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# ===== External Keycloak (on host) =====
# Full JWK URI - backend fetches JWT keys from here
XPOS_KEYCLOAK_JWK_URI=http://host.docker.internal:8080/realms/master/protocol/openid-connect/certs
# Optional: for ./deploy.sh check (host-side reachability)
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080

# ===== CORS (backend allows these frontend origins) =====
# Add more via XPOS_API_CORS_ALLOWED_ORIGINS_4, _5, etc. if needed
# XPOS_CORS_ENABLED=true

# ===== Custom domain (e.g. xpos.com) =====
# 1) Backend CORS: xpos.com / www.xpos.com are already allowed in application-prod.yml.
#    For another domain, add: XPOS_API_CORS_ALLOWED_ORIGINS_4=https://yourdomain.com
# 2) Build frontend image with your URLs, then deploy that image:
#    docker build -t xpos-ui:latest \
#      --build-arg VITE_API_BASE_URL=http://api.xpos.com \
#      --build-arg VITE_KEYCLOAK_URL=http://auth.xpos.com \
#      --build-arg VITE_KEYCLOAK_REALM=master \
#      --build-arg VITE_KEYCLOAK_CLIENT_ID=xpos-client-api .
# 3) Keycloak: in your realm client, set Valid redirect URIs to e.g. https://xpos.com/*

# ===== Frontend build-time (localhost) =====
# The UI image must be built with these matching your deployment:
# VITE_API_BASE_URL=http://localhost:9005
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=master
# VITE_KEYCLOAK_CLIENT_ID=xpos-client-api
