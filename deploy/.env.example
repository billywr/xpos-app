# XPOS Deployment - copy to .env and adjust
# Prerequisites: Postgres, Redis, Kafka, Keycloak already running on host
# cp .env.example .env

# ===== Image names (required) =====
XPOS_IMAGE=ghcr.io/your-org/xpos:latest
XPOS_UI_IMAGE=ghcr.io/your-org/xpos-ui:latest

# ===== Ports (host mapping for xpos and xpos-ui) =====
XPOS_PORT=9003
XPOS_UI_PORT=80

# ===== External PostgreSQL (on host) =====
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xpos

# ===== External Redis (on host) =====
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# ===== External Kafka (on host) =====
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# ===== External Keycloak (on host) =====
# Full JWK URI - backend fetches JWT keys from here
XPOS_KEYCLOAK_JWK_URI=http://host.docker.internal:8080/realms/master/protocol/openid-connect/certs
# Optional: for ./deploy.sh check (host-side reachability)
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080

# ===== Frontend build-time (only if building xpos-ui during deploy) =====
# The UI image must be built with these matching your deployment:
# VITE_API_BASE_URL=http://localhost:9003
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=master
# VITE_KEYCLOAK_CLIENT_ID=xpos-client-api
