# XPOS API (no trailing slash)
VITE_API_BASE_URL=http://localhost:9003

# Keycloak – base URL only (no path). Token URL: {VITE_KEYCLOAK_URL}/realms/{VITE_KEYCLOAK_REALM}/protocol/openid-connect/token
VITE_KEYCLOAK_URL=http://localhost:8088
VITE_KEYCLOAK_REALM=xpos
VITE_KEYCLOAK_CLIENT_ID=xpos-client-api

VITE_IDLE_LOGOUT_MINUTES=1